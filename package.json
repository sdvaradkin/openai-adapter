{
  "name": "openai-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude tests/**/*.integration.test.ts",
    "test:integration": "vitest run tests/docker.integration.test.ts",
    "test:integration:local": "npm run docker:build && npm run test:integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:ci": "npm run lint && npm test && npm run build && npm run docker:build && npm run docker:test && npm run test:integration",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "docker:build": "docker build -t openai-adapter:test .",
    "docker:test": "docker run -d -p 3000:3000 --name test-container openai-adapter:test && timeout /t 5 /nobreak >nul && curl -f http://localhost:3000/health && docker rm -f test-container",
    "docker:clean": "docker rm -f test-container 2>nul || true"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "pino": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.2",
    "typescript": "5.5.4",
    "vitest": "^1.5.3"
  }
}
